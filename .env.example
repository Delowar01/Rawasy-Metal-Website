# Copy to .env.local (never commit real values). Every variable is optional.

# The website's public origin, used for canonical URLs, hreflang alternates, Open Graph and Twitter tags, structured
# data, sitemap.xml and robots.txt. Read at build time: rebuild after changing it. Default: https://www.rawasymetal.com
NEXT_PUBLIC_SITE_URL=https://www.rawasymetal.com
