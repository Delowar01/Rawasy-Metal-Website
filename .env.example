# Copy to .env.local (never commit real values). Every variable is optional for the public website.

# The website's public origin, used for canonical URLs, hreflang alternates, Open Graph and Twitter tags, structured
# data, sitemap.xml and robots.txt. Read at build time: rebuild after changing it. Default: https://www.rawasymetal.com
NEXT_PUBLIC_SITE_URL=https://www.rawasymetal.com

# ---------------------------------------------------------------------------------------------------------------------
# Admin (Phase A2, local development only). Names and safe example values only: put real values in .env.local, never
# here. The public website needs none of them (it never reads the database), and `npm run build` must run without them.
# README, "Admin (local development)", explains each step; A1-SECURITY-RBAC §12 the secrets.

# Where this runs: local | staging | production. Without it a production build counts as production (the strictest).
# APP_ENV=local

# Whether this server serves the admin at all (pre-A9 release gate, A2 Correction 1). Exactly 1 turns it on; any other
# value turns it off; unset, it is on only in local development (APP_ENV=local, or `next dev`) and OFF in staging and
# production, where /admin then behaves as the public site's unknown address (locale redirect, localized 404). Leave it
# unset for every release before the A9 cutover. Never inferred from the DB_* settings.
# ADMIN_ENABLED=

# Local MariaDB (11.4-compatible). Never the hosting account's database.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_SOCKET_PATH=
# DB_NAME=rawasy_admin
# DB_USER=rawasy
# DB_PASSWORD=
# Connections one app process may open, 1–4 (production default 2 until measured on the account).
# DB_POOL_LIMIT=2

# Encryption of the two-factor (TOTP) secrets: base64 of 32 random bytes, with its version. Put a key in escrow
# (offline, outside the hosting account) BEFORE configuring it; retired versions stay listed ("version:base64,…")
# until no stored secret and no retained backup needs them. Local development: a throwaway key.
# AUTH_ENCRYPTION_KEY=
# AUTH_ENCRYPTION_KEY_VERSION=1
# AUTH_ENCRYPTION_RETIRED_KEYS=

# Password hashing: argon2id (default) or scrypt (only where the native Argon2 module cannot load).
# AUTH_PASSWORD_HASHER=argon2id

# Next.js Server Actions key (base64 of 32 random bytes): needed only where several processes or releases must share
# it (staging, production). Not needed locally.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# X-Forwarded-For entries added by the host's own proxies. Local default 0; must be set (after checking the host)
# anywhere else.
# TRUSTED_PROXY_HOPS=0

# The admin's origin, for the links the CLI prints or mails. Server Actions from any other Origin are refused, so it
# must match the address you open (default locally: http://localhost:3000).
# ADMIN_BASE_URL=http://localhost:3000

# Outgoing mail: disabled (default: nothing is sent, and the admin says so) or sink (local only: each message is
# written as a JSON file to MAIL_SINK_DIR, default <system temp>/rawasy-mail-sink). A2 has no SMTP transport.
# MAIL_TRANSPORT=disabled
# MAIL_SINK_DIR=

# The public site's content source: static until the A9 cutover (T1 = Option B). Nothing reads it in A2.
# CONTENT_SOURCE=static
